// Configuration for the vitest pool only; the CLI generates the real wrangler config at deploy time.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "agent-memory-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-25",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "d1_databases": [{ "binding": "DB", "database_name": "agent-memory-test", "database_id": "test", "migrations_dir": "migrations" }],
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "test" }],
  "assets": { "directory": "test/fixtures/assets", "binding": "SKILLS", "run_worker_first": true }
}
